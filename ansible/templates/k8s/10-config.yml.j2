apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  REDIS_PASSWORD: "{{ vault_redis_password }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: webapp-config
  namespace: {{ k8s_namespace }}
data:
  APP_ENV: "{{ app_env }}"
  APP_COLOR: "{{ app_color }}"
  REDIS_HOST: redis
  REDIS_PORT: "6379"
